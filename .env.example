# API
API_BIND=127.0.0.1:8080
WEB_ORIGIN=http://localhost:5173
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://localhost:8000
SESSIONS_TABLE=kloudlab-local-sessions
CATALOG_TABLE=kloudlab-local-catalog
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE
COGNITO_APP_CLIENT_ID=replace-with-public-app-client-id
LAB_PROVIDER=local
LAB_SESSION_TTL_MINUTES=60
# Browser values are public configuration only. Never use VITE_* for secrets.
VITE_API_BASE_URL=http://localhost:8080
VITE_COGNITO_DOMAIN=https://replace-me.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-with-public-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPES=openid email

# Backend-only payment configuration (not wired into browser builds)
RAZORPAY_KEY_ID=replace-on-server
RAZORPAY_KEY_SECRET=replace-on-server
RAZORPAY_WEBHOOK_SECRET=replace-on-server
