aws_region                  = "ap-south-1"
name_prefix                 = "kloudlab"
eks_kubernetes_version      = "1.36"
vpc_cidr                    = "10.40.0.0/16"
cluster_admin_role_arn      = "arn:aws:iam::111122223333:role/REPLACE_WITH_OPERATOR_ROLE"
cluster_public_access_cidrs = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
cognito_domain_prefix       = "replace-with-globally-unique-prefix"
cognito_callback_urls       = ["http://localhost:5173/callback"]
cognito_logout_urls         = ["http://localhost:5173/"]
github_repository           = "REPLACE_WITH_GITHUB_OWNER/kloudlab"

platform_desired_size      = 1
platform_min_size          = 1
platform_max_size          = 2
backend_desired_size       = 1
backend_min_size           = 1
backend_max_size           = 2
observability_desired_size = 1
observability_min_size     = 1
observability_max_size     = 2
