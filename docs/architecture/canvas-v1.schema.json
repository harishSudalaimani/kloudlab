{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kloudlab.in/schemas/canvas/v1/canvas.schema.json",
  "title": "KloudLab Canvas",
  "description": "Version 1 canvas document. Component configuration is validated against the pinned catalog component version on the server.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "viewport": {
      "$ref": "#/$defs/viewport"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "typeId", "componentVersion", "position", "config"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "typeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "componentVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "config": {
          "type": "object",
          "description": "Untrusted component configuration, validated against the catalog schema for typeId and componentVersion. Secret values are prohibited; use approved secret references."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "sourcePort", "target", "targetPort"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourcePort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetPort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "viewport": {
      "type": "object",
      "required": ["x", "y", "zoom"],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
