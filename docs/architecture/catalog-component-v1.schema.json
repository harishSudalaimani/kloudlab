{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kloudlab.in/schemas/catalog/component/v1/component.schema.json",
  "title": "KloudLab Catalog Component Definition",
  "type": "object",
  "required": [
    "typeId",
    "version",
    "displayName",
    "description",
    "configurationSchema",
    "ports",
    "validationRules",
    "documentation"
  ],
  "additionalProperties": false,
  "properties": {
    "typeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "configurationSchema": {
      "type": "object",
      "description": "A JSON Schema for this component's configuration. The server validates config against this schema before generating a plan."
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "validationRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationRule"
      }
    },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["id", "direction", "connectionTypes"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "direction": {
          "enum": ["input", "output"]
        },
        "connectionTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "multiple": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "validationRule": {
      "type": "object",
      "required": ["id", "scope", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "scope": {
          "enum": ["configuration", "connection", "architecture"]
        },
        "severity": {
          "enum": ["error", "warning"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["kind", "reference", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["pulumi-go", "kubernetes", "external"]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
